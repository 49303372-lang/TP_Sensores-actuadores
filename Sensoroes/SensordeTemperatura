#include <Wire.h>
#include <Adafruit_Sensor.h>
#include <Adafruit_BMP280.h>

Adafruit_BMP280 bmp; 

void setup() {

  Serial.begin(115200);
  delay(1000);
  Serial.println("Probano el BMP280");

  Wire.begin(21, 22); 

  if (!bmp.begin(0x76)) {

    Serial.println("Error: No se reconoce el BMP280");
    Serial.println("Verificando Chip ID");
    
    while (1) {

      Wire.beginTransmission(0x76);
      Wire.write(0xD0); 
      Wire.endTransmission();
      Wire.requestFrom(0x76, 1);
      if(Wire.available()) {
        Serial.print("El Chip ID de tu sensor es: 0x");
        Serial.println(Wire.read(), HEX);
      }
      delay(5000);
    }
  }
  
  Serial.println("Sensor BMP280 funcionando");
}

void loop() {

  Serial.print("Temperatura: ");
  Serial.print(bmp.readTemperature());
  Serial.println(" *C");

  Serial.print("Presión: ");
  Serial.print(bmp.readPressure() / 100.0F);
  Serial.println(" hPa");
  
  Serial.println("-----------------------");
  delay(2000);
}
